{% extends 'layouts.customer' %}

{% block head_scripts %}
  <script defer data-cfasync="false" src="{{ 'wishlist-card.js'|asset }}"></script>

  <script defer>
    document.addEventListener('DOMContentLoaded', () => {
      const productList = document.querySelector('#wishlist salla-products-list')
      if (!productList) return

      let userInteracted = false
      const observer = new MutationObserver(() => {
        const items = productList.querySelectorAll(
          'custom-wishlist-card, salla-product-card, .s-product-card-entry'
        )

        if (!userInteracted) {
          userInteracted = true
          return
        }

        if (items.length === 0) {
          window.location.reload()
        }
      })

      observer.observe(productList, {
        childList: true,
        subtree: true
      })
    })
  </script>
{% endblock %}

{% block inner_content %}
<div class="space-y-5 w-full" id="wishlist">
  {% hook 'customer:wishlist.items.start' %}

  <div class="JO-wishlist container">
    {% if (products|length) > 0 %}
      <salla-products-list
        source="wishlist"
        product-card-component="custom-wishlist-card">
      </salla-products-list>
    {% else %}
      <div class="no-content-placeholder">
        <!-- نفس SVG والـ empty state -->
      </div>
    {% endif %}
  </div>

  {% hook 'customer:wishlist.items.end' %}
</div>
{% endblock %}
{% block after_customer_content %}
<div class="latest">
  <div class="mb-6 lg:mb-8">
    <div class="head flex justify-center items-center">
      <h2 class="text-[clamp(1.25rem,1.0346rem+0.9654vw,2rem)] text-font">
        {{ trans('pages.cart.moreproducts') }}
      </h2>
    </div>

    {% if theme.settings.get('show_more') %}
      <div class="flex items-center justify-end">
        <a href="{{ store.url ~ '/offers' }}"
           class="relative text-graytext hover:text-primary flex items-center gap-1">
          {{ trans('pages.cart.viewall') }}
          <i class="sicon-arrow-left ltr:rotate-180"></i>
        </a>
      </div>
    {% endif %}
  </div>

  <salla-products-slider
    source="latest"
    show-controls="{{ theme.settings.get('show_more') ? 'false' : 'true' }}"
    slider-config='{
      "slidesPerView": 1.2,
      "spaceBetween": 10,
      "speed": 1000,
      "effect": "slide",
      "centeredSlides": false,
      "breakpoints": {
        "551": {"spaceBetween": 10 , "slidesPerView": 2.2 },
        "768": {"spaceBetween": 10 , "slidesPerView": 3.2 },
        "1024": { "spaceBetween": 10, "slidesPerView": 4.2 }
      }
    }'
    display-all-url>
  </salla-products-slider>
</div>
<style>
      .s-products-list-vertical-cards {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1024px) {
    .s-products-list-vertical-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .s-products-list-vertical-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Small Mobile */
  @media (max-width: 375px) {
    .s-products-list-vertical-cards {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }

  /* Customer layout fix */
  .main-content.max-w-3xl {
    max-width: 100% !important;
  }

  /* Hide slider nav */
  .latest .s-slider-block__title-nav {
    display: none !important;
  }
	.main-content.max-w-3xl{
		max-width: 100% !important;
	}
</style>
{% endblock %}
