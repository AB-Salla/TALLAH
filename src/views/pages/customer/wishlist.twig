{% extends 'layouts.customer' %}

{% block head_scripts %}

  <script defer data-cfasync="false" src="{{ 'wishlist-card.js'|asset }}"></script>

  <script defer>
    document.addEventListener('DOMContentLoaded', () => {
      const productList = document.querySelector('#wishlist salla-products-list')
      if (!productList) return
    
      let userInteracted = false // فلاغ للتأكد من أول تعديل
      const observer = new MutationObserver(() => {
        const items = productList.querySelectorAll('custom-wishlist-card, salla-product-card, .s-product-card-entry')
        if (!userInteracted) {
          // أول مرة يتغير فيها الليست نعتبر إن فيه Action حصل
          userInteracted = true
          return
        }
    
        // بعد أول Action فقط لو الليست فضيت → Refresh
        if (items.length === 0) {
          window.location.reload()
        }
      })
    
      observer.observe(productList, {
        childList: true,
        subtree: true
      })
    })
  </script>
{% endblock %}

