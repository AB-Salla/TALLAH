<section class="Ar-special-banner Ar-special-banner-{{position}} s-block">

<div class="flex flex-col md:flex-row w-full">
 {% for item in  component.banner %}                                    
			<div class="md:w-1/2 w-full banner  banner-{{loop.index}}  flex flex-col items-start justify-end relative md:h-[90vh] h-[50vh] md:py-6 py-4 px-4  overflow-hidden">
			{% if not item.button_text %}
             <a class="w-full h-full absolute inset-0 z-[5]" href="{{item.url}}"></a> 
             {% endif %}
    

                <div  class="text-wrapper text-start m-0  h-full flex flex-col  items-start justify-end sm:gap-4 gap-2 relative z-2 container">
					{% if item.block_title %}
                    	<h1  aria-label="العنوان الرئيسي" class="blocktitle text-xl font-semibold text-background ">{{item.block_title}}</h1>
					{% endif %}
					{% if item.subtext %}
                    	<p  class="subtext text-background font-light text-[clamp(0.875rem,0.7602rem+0.4898vw,1.25rem)] max-w-1/2">{{item.subtext}}</p>
					{% endif %}
                    {% if item.button_text %}
						<a  class="block button button-{{loop.index}} rounded-md bg-primary  text-background px-4 sm:px-7 py-2 text-[clamp(0.75rem,0.6447rem+0.4493vw,1.094rem)] 
						transition-colors duration-300 ease-in-out hover:bg-background hover:text-primary  border border-[color-mix(in srgb,var(--color-primary)15%,white)] hover:border-primary " href="{{item.url}}">{{item.button_text}}</a>
					{% endif %}
                
				</div>

        
			</div>
            {% endfor %}

</div>
<section>
<style>
.Ar-special-banner .swiper-pagination-bullet{
	margin:0px;
	background:var(--color-background);
	height:2px;
	flex:1 1 0%;
}
{% if component.transparent_button %}
.Ar-special-banner-{{position}}  .button{
	background-color: {{component.button_bg}}77;
    backdrop-filter:blur(5px);
}
.Ar-special-banner-{{position}}  .button:hover{
	color:var(--color-background);
    background-color:var(--color-primary);

}
{% elseif component.use_custom_colors  %}
    .Ar-special-banner-{{position}}  .button{
	color:{{component.button_text_color}};
	background-color:{{component.button_bg}};
    border-color:{{component.button_text_color}};
}
.Ar-special-banner-{{position}}  .button:hover{
	background-color:{{component.button_text_color}};
	color:{{component.button_bg}};
    border-color:{{component.button_bg}};
}
{% endif %}
{% if component.use_custom_colors %}
.Ar-special-banner-{{position}} .text-wrapper h1{
	color:{{component.blocktitle_color}};
}
.Ar-special-banner-{{position}} .text-wrapper p{
	color:{{component.subtext_color}};
}
.Ar-special-banner-{{position}}  .button{
	color:{{component.button_text_color}};
	background-color:{{component.button_bg}};
    border-color:{{component.button_text_color}};
}
.Ar-special-banner-{{position}}  .button:hover{
	background-color:{{component.button_text_color}};
	color:{{component.button_bg}};
    border-color:{{component.button_bg}};
}
{% endif %}


{% for item in component.banner %}
/* Mobile */
{% if citem.mobile_bg %}

.Ar-special-banner-{{position}} .banner-{{loop.index}}  {
    background: url({{item.mobile_bg}}) center center / cover no-repeat;
}
/* Desktop (default) */
@media (min-width: 768px) {
    .Ar-special-banner-{{position}} .banner-{{loop.index}}  {
        background: url({{item.desktop_bg}}) center center / cover no-repeat;
    }
}
{% else %}
    .Ar-special-banner-{{position}} .banner-{{loop.index}}  {
        background: url({{item.desktop_bg}}) center center / cover no-repeat;
    }

    
{% endif %}

{% endfor %}
</style>