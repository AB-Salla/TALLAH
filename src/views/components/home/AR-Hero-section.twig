<section class="AR-slider-hero-section AR-slider-hero-section-{{position}} s-block s-block-{{position}}">
	<div class="wrapper">
		<div class="relative">

        <salla-slider
			 id="sub-banner-slider-{{position}}" class="subbanner-slider" slider-config='{
			 "parallax":true,
    "pagination": {
      "el": ".AR-slider-hero-section-{{position}} .swiper-pagination",
      "type": "bullets",
      "clickable": true
    },
    "spaceBetween": 0,
    "lazy": true,
    "speed": 1000,
	"loop":false
  }'
 			show-controls="false" type="blog">
				<div slot="items">
            {% for item in  component.banner %}                                    
			<div class="banner  banner-{{loop.index}}  flex flex-col items-center justify-center relative md:h-[90vh] h-[100svh] md:px-4 px-2 py-16 overflow-hidden">
			{% if not item.button_text %}
             <a class="w-full h-full absolute inset-0 z-[5]" href="{{item.url}}"></a> 
             {% endif %}
    

                <div  class="text-wrapper h-full flex flex-col text-center items-center justify-center sm:gap-4 gap-2 mx-auto relative z-2 container">
					{% if item.block_title %}
                    	<h1 data-swiper-parallax="-700"  aria-label="العنوان الرئيسي" class="blocktitle text-[clamp(1rem,0.6939rem+1.3061vw,2rem)] text-background font-normal md:font-semibold transition-all duration-700 ease-in-out">{{item.block_title}}</h1>
					{% endif %}
					{% if item.subtext %}
                    	<p data-swiper-parallax="-500" class="subtext text-background font-light text-[clamp(0.875rem,0.7602rem+0.4898vw,1.25rem)] transition-all duration-700 ease-in-out">{{item.subtext}}</p>
					{% endif %}
					{% if not component.button_bottom %}

					{% if item.button_text %}
						<a data-swiper-parallax="-300"  class="block text-center button button-{{loop.index}} self-center rounded-md bg-primary  mt-auto text-background px-4 sm:px-7 py-2 text-[clamp(0.75rem,0.6447rem+0.4493vw,1.094rem)] 
						transition-all hover:bg-background hover:text-primary  border border-[color-mix(in srgb,var(--color-primary)15%,white)] hover:border-primary justify-self-end " href="{{item.url}}">{{item.button_text}}</a>
					{% endif %}
					{% endif %}
                
				</div>
				{% if component.button_bottom %}
				    {% if item.button_text %}
						<a data-swiper-parallax="-300"  class="block text-center button button-{{loop.index}} self-center rounded-md bg-primary  mt-auto text-background px-4 sm:px-7 py-2 text-[clamp(0.75rem,0.6447rem+0.4493vw,1.094rem)] 
						transition-all hover:bg-background hover:text-primary  border border-[color-mix(in srgb,var(--color-primary)15%,white)] hover:border-primary justify-self-end " href="{{item.url}}">{{item.button_text}}</a>
					{% endif %}
					{% endif %}
        
			</div>
            {% endfor %}


            		</div>
	
				</salla-slider>
									<div class="swiper-pagination !bottom-8 justify-center gap-2 !absolute items-center m-0 flex !w-1/4 !left-1/2 -translate-x-1/2"></div>


		</div>
	</div>
</section>
<style>
.AR-slider-hero-section .swiper-pagination-bullet{
	margin:0px;
	background:var(--color-background);
	height:2px;
	flex:1 1 0%;
	transition:all .5s ease-in-out; 
}
{% if component.transparent_button %}
.AR-slider-hero-section-{{position}}  .button{
	background-color: transparent;
    color:{{component.button_text_color}};
    border-color:{{component.button_text_color}};
}
.AR-slider-hero-section-{{position}}  .button:hover{
	background-color:{{component.button_text_color}};
    color:{{component.button_bg}};

}
  {% else %}
    .AR-slider-hero-section-{{position}}  .button{
	color:{{component.button_text_color}};
	background-color:{{component.button_bg}};
    border-color:{{component.button_text_color}};
}
.AR-slider-hero-section-{{position}}  .button:hover{
	background-color:{{component.button_text_color}};
	color:{{component.button_bg}};
    border-color:{{component.button_bg}};
}
  {% endif %}

.AR-slider-hero-section .swiper-pagination-bullet{
	color:{{component.blocktitle_color}};

}
.AR-slider-hero-section-{{position}} .text-wrapper h1{
	color:{{component.blocktitle_color}};
}
.AR-slider-hero-section-{{position}} .text-wrapper p{
	color:{{component.subtext_color}};
}

{% for item in component.banner %}
/* Mobile */
.AR-slider-hero-section-{{position}} .banner-{{loop.index}}  {
    background: url({{item.mobile_bg}}) center center / cover no-repeat;
}
/* Desktop (default) */
@media (min-width: 768px) {
    .AR-slider-hero-section-{{position}} .banner-{{loop.index}}  {
        background: url({{item.desktop_bg}}) center center / cover no-repeat;
    }
}
{% endfor %}
{% if component.banner|length > 1 %}
.AR-slider-hero-section .swiper-slide{
    pointer-events: none;
}
.AR-slider-hero-section .swiper-slide.swiper-slide-active{
    pointer-events: all;
}
{% endif %}
</style>
