<section class="AR-hero-section AR-hero-section-{{position}} s-block s-block-{{position}}">
	<div class="wrapper">
                                  
			<div class="banner   flex flex-col items-center justify-center relative md:h-[90vh] h-[100svh] py-6 overflow-hidden">
			{% if not component.button_text %}
             <a class="w-full h-full absolute inset-0 z-[5]" href="{{component.url}}"></a> 
             {% endif %}
    

                <div  class="text-wrapper h-full flex flex-col text-center items-center justify-center sm:gap-4 gap-2 mx-auto relative z-2 container">
					{% if component.block_title %}
                    	<h1 data-swiper-parallax="-500"  aria-label="العنوان الرئيسي" class="blocktitle text-[clamp(1rem,0.6939rem+1.3061vw,2rem)] text-background font-normal md:font-semibold transition-all duration-700 ease-in-out">{{component.block_title}}</h1>
					{% endif %}
					{% if component.subtext %}
                    	<p data-swiper-parallax="-250" class="subtext text-background font-light text-[clamp(0.875rem,0.7602rem+0.4898vw,1.25rem)] transition-all duration-700 ease-in-out">{{component.subtext}}</p>
					{% endif %}
                
				</div>
				    {% if component.button_text %}
						<a  class="block button button-{{loop.index}} self-center rounded-md bg-primary  mt-auto text-background px-4 sm:px-7 py-2 text-[clamp(0.75rem,0.6447rem+0.4493vw,1.094rem)] 
						transition-all duration-500 ease-in-out hover:bg-background hover:text-primary  border border-[color-mix(in srgb,var(--color-primary)15%,white)] hover:border-primary justify-self-end " href="{{component.url}}">{{component.button_text}}</a>
					{% endif %}
        
			</div>
        

		</div>
	</div>
</section>
<style>

{% if component.transparent_button %}
.AR-hero-section-{{position}}  .button{
	background-color: transparent;
        color:{{component.button_text_color}};
            border-color:{{component.button_text_color}};


}
.AR-hero-section-{{position}}  .button:hover{
	background-color:{{component.button_text_color}};
    color:{{component.button_bg}};

}

  {% else %}

  
    .AR-hero-section-{{position}}  .button{
	color:{{component.button_text_color}};
	background-color:{{component.button_bg}};
    border-color:{{component.button_text_color}};
}
.AR-hero-section-{{position}}  .button:hover{
	background-color:{{component.button_text_color}};
	color:{{component.button_bg}};
    border-color:{{component.button_bg}};
}
  {% endif %}


.AR-hero-section-{{position}} .text-wrapper h1{
	color:{{component.blocktitle_color}};
}
.AR-hero-section-{{position}} .text-wrapper p{
	color:{{component.subtext_color}};
}


/* Mobile */
.AR-hero-section-{{position}} .banner {
    background: url({{component.mobile_bg}}) center center / cover no-repeat;
}
/* Desktop (default) */
@media (min-width: 768px) {
    .AR-hero-section-{{position}} .banner  {
        background: url({{component.desktop_bg}}) center center / cover no-repeat;
    }
}

</style>
