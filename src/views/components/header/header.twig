                stroke-linejoin="round" />
            </g>
            <defs>
              <clipPath id="clip0">
                <rect width="20" height="20" fill="white" />
              </clipPath>
            </defs>
          </svg>
        </button>
      </div>

    </div>
  </div>



</header>




{# =====================================
3) DESKTOP MEGA MENU LAYER
===================================== #}{# in pc view #}
{# Background Overlay #}
<div id="mega-overlay-background" class="fixed inset-0 bg-black bg-opacity-50 z-10 hidden"
  style="top: var(--header-height);"></div>

{# Mega Content #}
<div id="mega-content" class="fixed flex flex-row items-start gap-[49px] left-0 w-screen h-[70vh] z-20 
            transform scale-y-0 opacity-0 pointer-events-none 
            origin-top shadow-lg transition-all duration-300 -translate-y-full
            border-t border-gray-500" style="background-color: {{ header_bg_color }}; top: var(--header-height);">

  {# Left: Child Categories Wrapper #}
  <div class="flex w-[328px] h-full flex-col items-start gap-[20px] shrink-0 bg-zinc-100">

    <ul id="mega-childs" class="w-full p-[48px_68px_48px_64px] space-y-2" style="color: {{ initial_text }};"></ul>
  </div>

  {# Right: Subcategories + Images Section #}
  <div class="flex w-[994px] py-[48px] flex-col gap-[16px]">

    {# Category Title #}
    <div class="w-full border-b border-gray-500">
      <span id="mega-category-title"
        class="w-full self-stretch text-zinc-800 text-sm font-medium leading-4 tracking-wide uppercase"></span>
    </div>

    {# Subcategories + Images flex row #}
    <div class="flex items-start w-full justify-between ">
      {# Subcategories List(s) #}
      <div id="mega-subcategories" class="flex items-start gap-4" style="color: {{ initial_text }};"></div>

      {# Images #}
      <div id="mega-images" class="flex gap-2 align-center" style="color: {{ initial_text }};"></div>
    </div>

  </div>
</div>

{# =====================================
4) SIMPLE MENU (Fallback / compact)
===================================== #}
<div id="simple-menu" class="w-[242px] h-[375px]  p-[24px_24px_40px_24px] items-start gap-[16px] shrink-0 
     flex flex-col bg-white shadow-md fixed  z-20 
            transform scale-y-0 opacity-0 pointer-events-none 
            origin-top transition-all duration-200" style="top: var(--header-height);">
  <ul id="simple-menu-list" class="flex flex-col p-4 space-y-2 text-sm text-black"></ul>
</div>



{# =====================================
5) MOBILE MENU (Overlay)
===================================== #}
<div id="mobile-menu-overlay"
  class="fixed inset-0 z-20 lg:hidden bg-black bg-opacity-50 transition-opacity duration-300">
  <div id="mobile-menu-wrapper" class="fixed inset-0 z-30 bg-white flex flex-col">

    {# menu tabs #}
    <div class="border-t border-b text-sm font-semibold gap-[12px] py-3 px-4 mt-[var(--header-height)]">
      <div class="flex flex-col items-center gap-[12px] self-stretch">
        <div id="mobile-menu-tabs" class="flex justify-around gap-[16px] w-full overflow-x-auto no-scrollbar">
          <!-- Tabs injected here -->
        </div>
      </div>
    </div>

    {# Scrollable Menu Content #}
    <div id="mobile-menu-content" class="flex-1 flex flex-col overflow-y-auto p-5 no-scrollbar">
      <!-- Filled by JS -->
    </div>

    {# Optional: Subcategory Panel #}
    <div id="mobile-subcategory-content"
      class="absolute w-full overflow-y-auto no-scrollbar transition-transform duration-500 ease-in-out"
      style="background-color: {{ header_bg_color }}; top: var(--header-height); height: calc(100dvh - var(--header-height));">
    </div>

  </div>
</div>



{# =====================================
6) SEARCH OVERLAY PANEL
===================================== #}
<div id="search-overlay-container" class="fixed inset-0 z-20 hidden">
  <div id="search-overlay-background" class="sm:top-0 absolute left-0 right-0 bottom-0 bg-black bg-opacity-50"
    style="top: var(--header-height);"></div>

  <div id="search-panel-wrapper" class="absolute w-full h-full lg:h-[70vh] overflow-hidden"
    style="top: var(--header-height);">
    <div id="search-panel"
      class="relative z-30 w-full bg-white shadow-lg transition-all duration-300 -translate-y-full">
      <div
        class="mx-auto flex flex-col items-start gap-6 lg:gap-[32px] w-full max-w-full px-4 py-4 lg:w-[777px] lg:px-0 lg:py-6">
        <div class="flex h-[40px] items-center self-stretch">

          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <g clip-path="url(#clip0_6813_1469)">
              <path
                d="M9.16667 15.8333C12.8486 15.8333 15.8333 12.8486 15.8333 9.16667C15.8333 5.48477 12.8486 2.5 9.16667 2.5C5.48477 2.5 2.5 5.48477 2.5 9.16667C2.5 12.8486 5.48477 15.8333 9.16667 15.8333Z"
                stroke="#9F9FA9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M17.5 17.5L13.875 13.875" stroke="#9F9FA9" stroke-width="1.5" stroke-linecap="round"
                stroke-linejoin="round" />
            </g>
            <defs>
              <clipPath id="clip0_6813_1469">
                <rect width="20" height="20" fill="white" />
              </clipPath>
            </defs>
          </svg>
          <div class="relative w-full mx-auto">

            <input id="custom-search-input" type="text"
              placeholder="{% if language.iso_code == 'ar' %}ابحث{% else %}Search{% endif %}"
              class="w-full border-0 border-b border-gray-300 focus:outline-none focus:border-b focus:border-gray-500" />

            <!-- Results Dropdown -->
            <div id="custom-search-results"
              class="absolute left-0 right-0 bg-white border border-gray-200 rounded-lg shadow-lg z-50 hidden">
              <ul id="custom-search-list" class="divide-y divide-gray-100 max-h-64 overflow-y-auto"></ul>
              <div id="custom-no-results" class="text-gray-500 px-4 py-2 hidden">لا توجد نتائج</div>
            </div>
          </div>


        </div>
        <!-- Search Input -->


        <!-- Result container -->
        <div id="search-results" class="mt-4 hidden"></div>
        <div id="no-results" class="mt-4 hidden text-red-500">No results found</div>





        <div class="flex flex-col items-start gap-8 lg:gap-12 self-stretch">

          {# Trending keywords #}
          {% set trending_keywords = theme.settings.get('trending-search-keywords') %}
          {% set trending_keywords_filtered = [] %}
          {% for item in trending_keywords %}
          {% set keyword = item['search-keyword'][language.iso_code] | trim %}
          {% if keyword != '' %}
          {% set trending_keywords_filtered = trending_keywords_filtered | merge([item]) %}
          {% endif %}
          {% endfor %}



          {% if trending_keywords_filtered | length > 0 %}
          <div class="flex flex-col sm:flex-row w-full items-start sm:items-center gap-4 lg:gap-[15px]">
            <h4 class="text-sm font-medium leading-6 tracking-wide">
              {% if language.iso_code == 'ar' %}
              كلمات بحث رائجة:
              {% else %}
              Trending Searches:
              {% endif %}
            </h4>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 lg:gap-x-8">
              {% for item in trending_keywords_filtered %}
              {% set keyword = item['search-keyword'][language.iso_code] | trim %}
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 stroke-[#9F9FA9]" fill="none" viewBox="0 0 16 16"
                  xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M8 5.33333V8L10 10M14 8C14 8.78793 13.8448 9.56815 13.5433 10.2961C13.2417 11.0241 12.7998 11.6855 12.2426 12.2426C11.6855 12.7998 11.0241 13.2417 10.2961 13.5433C9.56815 13.8448 8.78793 14 8 14C7.21207 14 6.43185 13.8448 5.7039 13.5433C4.97595 13.2417 4.31451 12.7998 3.75736 12.2426C3.20021 11.6855 2.75825 11.0241 2.45672 10.2961C2.15519 9.56815 2 8.78793 2 8C2 6.4087 2.63214 4.88258 3.75736 3.75736C4.88258 2.63214 6.4087 2 8 2C9.5913 2 11.1174 2.63214 12.2426 3.75736C13.3679 4.88258 14 6.4087 14 8Z"
                    stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <button type="button" class="trending-keyword-btn" data-keyword="{{ keyword|e }}">
                  {{ keyword }}
                </button>
              </span>
              {% endfor %}
            </div>
          </div>
          {% endif %}

          {# Popular categories #}
          {% set categories = theme.settings.get('popular-categories') %}
          {% set valid_categories = [] %}
          {% for category in categories %}
          {% set image = category['popular-categories-image'] | trim %}
          {% if image != '' %}
          {% set valid_categories = valid_categories | merge([category]) %}
          {% endif %}
          {% endfor %}

          {% if valid_categories | length > 0 %}
          <div class="flex flex-col items-start gap-4 lg:gap-6 self-stretch">
            <h4 class="text-lg lg:text-xl font-semibold leading-7 lg:leading-8 tracking-wide">
              {% if language.iso_code == 'ar' %}
              فئات شائعة
              {% else %}
              Popular Categories
              {% endif %}
            </h4>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 lg:gap-4 w-full">
              {% for category in valid_categories %}
              {% set link = category['popular-categories-link'] %}
              {% set image = category['popular-categories-image'] | trim %}
              {% if image != '' %}
              {% if link %}
              <a href="{{ link }}" class="bg-gray-100 aspect-[4/3] flex items-center justify-center overflow-hidden ">
                <img src="{{ image }}" alt="Category" class="object-cover w-full h-full">
              </a>
              {% else %}
              <div class="bg-gray-100 aspect-[4/3] flex items-center justify-center overflow-hidden">
                <img src="{{ image }}" alt="Category" class="object-cover w-full h-full">
              </div>
              {% endif %}
              {% endif %}
              {% endfor %}
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>