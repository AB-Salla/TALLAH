{# ------------------------------
Global Variables (from Theme)
------------------------------- #}
{% set topnav_bg = theme.settings.get('header-topnav-background') ?? 'var(--600, #000)' %}
{% set topnav_text_color = theme.settings.get('header-topnav-text-color') ?? '#fff' %}
{% set topnav_text = theme.settings.get('header-topnav-text') ?? 'Get access on launches and offers.' %}
{% set topnav_special_text = theme.settings.get('header-topnav-special-text') ?? 'Sign Up For Texts' %}
{% set topnav_special_text_color = theme.settings.get('header-topnav-special-text-color') ?? '#666666' %}
{% set link_url = theme.settings.get('header-topnav-link-url') %}
{% set is_rtl = language.iso_code == 'ar' %}
{% set countdown_target = theme.settings.get('header-topnav-count-down') %}
{% set countdown_bg = theme.settings.get('count-down-background') ?? '#3f3f46' %}
{% set countdown_text = theme.settings.get('count-down-text-color') ?? '#ffffff' %}
{% set header_hover = theme.settings.get('header-hover') %}
{% set header_bg_color = theme.settings.get('header-background-color') ?? '#ffffff' %}
{% set header_text_color = theme.settings.get('header-text-color') ?? '#000000' %}
{% set advanced_menu = theme.settings.get('advanced-menu') %}

{# Expose a couple vars to JS context #}
<script>
  window.isAdvancedMenuEnabled = {{ advanced_menu ? 'true' : 'false' }};
  window.header_bg_color = '{{ header_bg_color }}';
  window.header_text_color = '{{ header_text_color}}';
  window.isHomePage = "{{ page.slug|default('') }}" === "index";
  window.languageCode = '{{ language.iso_code }}';
</script>

<header class="store-header {{ header_bg }} w-full fixed top-0 left-0 z-50">


  {# =====================================
  1) TOP NOTIFICATION BAR (Clickable)
  ====================================== #}

  {% if link_url %}
  <a href="{{ link_url }}" class="block no-underline" style="text-decoration: none;">
    {% endif %}

    <div
      class="flex w-full h-[38px] p-[7px_21px] justify-center items-center gap-[4px] lg:flex lg:px-[30px] lg:py-[7px] lg:justify-between lg:items-center lg:self-stretch {{ is_rtl ? 'flex-row-reverse' : 'flex-row' }}"
      style="background-color: {{ topnav_bg }}; color: {{ topnav_text_color }};">
      <div class="flex justify-center items-center gap-1 flex-[1_0_0]">

        <div class="flex flex-row items-center gap-1">



          {# Countdown Timer #}
          <div id="countdown" data-countdown-target="{{ countdown_target }}"
            style="background-color: {{ countdown_bg }}; color: {{ countdown_text }};" class=" flex h-[22px] px-[12px] py-[10px] justify-center items-center gap-[4px] rounded-lg
     lg:flex lg:h-[22px] lg:py-[4px] lg:px-4 lg:gap-2 ">

            <div class="flex items-baseline gap-0.5">
              <span id="cd-days" class="text-sm font-bold">0</span>
              <span class="text-xs">
                {% if language.iso_code == 'ar' %}يوم{% else %}d{% endif %}
              </span>
            </div>

            <span class="text-sm">:</span>

            <div class="flex items-baseline gap-0.5">
              <span id="cd-hours" class="text-sm font-bold">0</span>
              <span class="text-xs">
                {% if language.iso_code == 'ar' %}س{% else %}h{% endif %}
              </span>
            </div>

            <span class="text-sm">:</span>

            <div class="flex items-baseline gap-0.5">
              <span id="cd-minutes" class="text-sm font-bold">0</span>
              <span class="text-xs">
                {% if language.iso_code == 'ar' %}د{% else %}m{% endif %}
              </span>
            </div>

            <span class="text-sm">:</span>

            <div class="flex items-baseline gap-0.5">
              <span id="cd-seconds" class="text-sm font-bold">0</span>
              <span class="text-xs">
                {% if language.iso_code == 'ar' %}ث{% else %}s{% endif %}
              </span>
            </div>
          </div>








          {# First Text #}
          <span
            class="text-center text-[10px] not-italic font-medium leading-[20px] tracking-normal lg:text-xs lg:leading-5 hidden lg:block">
            {{ topnav_text }}
          </span>


          {# Special Text with custom color #}
          <span
            class="text-center text-[11px] not-italic font-normal leading-[16px] tracking-normal lg:text-xs lg:leading-5"
            style="color: {{ topnav_special_text_color }}">
            {{ topnav_special_text }}
          </span>


          {# Icon - User Image or Default #}
          <span class="flex justify-center items-center w-[14px] h-[14px] lg:w-4 lg:h-4">
            {% set icon_url = theme.settings.get('header-topnav-icon-url') %}
            {% if icon_url %}
            <img src="{{ icon_url }}" alt="Icon" class="w-[14px] h-[14px] lg:w-4 lg:h-4" />
            {% endif %}
          </span>




        </div>





        {# Language & Currency Component #}
        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
        <button type="button" onclick="salla.event.dispatch('localization::open')"
          class="hidden lg:flex items-center gap-[12px] absolute {{ is_rtl ? 'left-[30px]' : 'right-[30px]' }} top-[9px]"
          style="color: {{ topnav_text_color }};">
          <span class="flag iti__flag iti__{{ user.language.country_code }} w-[21px] h-[15px]"></span>
          <span class="font-normal text-[12px] leading-[16px] tracking-[0.2px]">{{ currency.symbol }}</span>
        </button>
        <salla-localization-modal></salla-localization-modal>
        {% endif %}

      </div>
    </div>

    {% if link_url %}
  </a>
  {% endif %}




  {# =====================================
  2) HEADER CORE (Hover styles supported)
  ====================================== #}
  {% if page.slug == 'index' %}
  {# Homepage header variables #}
  {% if header_hover %}
  {% set initial_bg = 'linear-gradient(0deg, rgba(0, 0, 0, 0.00) 0%, #000 100%)' %}
  {% set initial_text = 'white' %}
  {% set hover_vars = '--hover-bg:' ~ header_bg_color ~ '; --hover-text:' ~ header_text_color %}
  {% else %}
  {% set initial_bg = header_bg_color %}
  {% set initial_text = header_text_color %}
  {% set hover_vars = '' %}
  {% endif %}
  {% else %}
  {# Other pages header variables #}
  {% set initial_bg = header_bg_color %}
  {% set initial_text = header_text_color %}
  {% set hover_vars = '--hover-bg:' ~ header_bg_color ~ '; --hover-text:' ~ header_text_color %}
  {% endif %}


  {# If hover is enabled, define CSS rule to apply dynamic background and text color on hover using CSS variables #}
  {% if header_hover %}
<style>
  .group:hover .hover-box {
    background-color: var(--hover-bg) !important;
    color: var(--hover-text) !important;
  }

  .site-header.header-scrolled {
    background-color: {{ header_bg_color }} !important;
    color: {{ header_text_color }} !important;
  }

  .site-header.active-overlay {
    background-color: {{ header_bg_color }} !important;
    color: {{ header_text_color }} !important;
  }
</style>

  {% endif %}


  {# 'group' = parent hover trigger for .hover-box #}
  <div class="group w-full" style="{{ hover_vars }}">
    {# header for pc view #}
    <div class="site-header hover-box w-full h-[60px] px-16  flex flex-row-reverse justify-between items-center
            hidden lg:flex" style="background-color: {{ initial_bg }}; color: {{ initial_text }};">


      {# ICONS SECTION #}
      <div class="flex justify-end items-center gap-2">




        {# Search Toggle Button #}
        <button id="search-toggle" class="flex p-3 items-center justify-center" aria-label="Open Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 20 20">
            <g clip-path="url(#clip0)">
              <path
                d="M9.16667 15.8333C12.8486 15.8333 15.8333 12.8486 15.8333 9.16667C15.8333 5.48477 12.8486 2.5 9.16667 2.5C5.48477 2.5 2.5 5.48477 2.5 9.16667C2.5 12.8486 5.48477 15.8333 9.16667 15.8333Z"
                stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M17.5 17.5L13.875 13.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                stroke-linejoin="round" />
            </g>
            <defs>
              <clipPath id="clip0">
                <rect width="20" height="20" fill="white" />
              </clipPath>
            </defs>
          </svg>
        </button>



        {# user icon #}
        <a onclick="salla.event.dispatch('login::open')" class="flex p-3 justify-center items-center cursor-pointer">
