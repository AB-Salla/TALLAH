              <clipPath id="clip0_5899_2043">
                <rect width="20" height="20" fill="white" />
              </clipPath>
            </defs>
          </svg>
        </a>



        {# Wishist#}
        <a href="{{ url('wishlist') }}" class="flex p-3 items-center justify-center z-50 relative"
          aria-label="Go to wishlist">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path
              d="M16.2796 4.55371C17.9068 6.1809 17.9068 8.81908 16.2796 10.4463L10.7071 16.0188C10.3166 16.4093 9.68341 16.4093 9.29288 16.0188L3.72039 10.4463C2.0932 8.81908 2.0932 6.1809 3.72039 4.55371C5.014 3.2601 6.57547 2.86401 8.15104 3.6328C8.7764 3.93794 9.59634 4.55371 9.99999 5.35806C10.4036 4.55371 11.2236 3.93794 11.8489 3.6328C13.4245 2.86401 14.986 3.2601 16.2796 4.55371Z"
              stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>


        {# Cart icon #}
        <a href="{{ url('cart') }}" class="flex p-3 items-center justify-center z-50 relative" aria-label="Go to cart">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path
              d="M12.9576 8.76923V5.07692C12.9576 3.37759 11.6334 2 10 2C8.36657 2 7.04241 3.37759 7.04241 5.07692V8.76923M15.9988 7.13414L16.995 16.9803C17.0502 17.5253 16.6394 18 16.1126 18H3.88737C3.36059 18 2.94982 17.5253 3.00497 16.9803L4.00121 7.13414C4.04874 6.66434 4.42954 6.30769 4.88361 6.30769H15.1164C15.5705 6.30769 15.9513 6.66434 15.9988 7.13414ZM7.33817 8.76923C7.33817 8.93916 7.20576 9.07692 7.04241 9.07692C6.87907 9.07692 6.74666 8.93916 6.74666 8.76923C6.74666 8.5993 6.87907 8.46154 7.04241 8.46154C7.20576 8.46154 7.33817 8.5993 7.33817 8.76923ZM13.2533 8.76923C13.2533 8.93916 13.1209 9.07692 12.9576 9.07692C12.7942 9.07692 12.6618 8.93916 12.6618 8.76923C12.6618 8.5993 12.7942 8.46154 12.9576 8.46154C13.1209 8.46154 13.2533 8.5993 13.2533 8.76923Z"
              stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>


      </div>


      {# LOGO SECTION #}
      <div
        class="flex w-[66px] h-[36px] p-[8px_0px] flex-col justify-center items-center gap-[12px] shrink-0 t py-5 px-3"
        style="color: {{ initial_text }};">
        <a class="navbar-brand" href="{{ store.url }}">
          <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo }}"
            alt="{{ store.name }} logo">
          {% if is_page('index') %}
          <h1 class="sr-only">{{ store.name }}</h1>
          {% else %}
          <h2 class="sr-only">{{ store.name }}</h2>
          {% endif %}
        </a>
      </div>


      {# icons & menu #}
      <div class="flex items-center justify-between">

        {# mobile nav button #}
        <button id="mobile-menu-toggle" class="flex p-3 items-center justify-center z-50 relative">
          {% if language.iso_code == 'ar' %}

          <!-- Arabic icon -->
          <svg id="icon-open" class="block" xmlns="http://www.w3.org/2000/svg" width="34" height="34"
            viewBox="0 0 34 34" fill="none">
            <path d="M23.666 22H17.8327M23.666 12H10.3327H23.666ZM23.666 17H10.3327H23.666Z" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {% else %}
          <!-- English icon -->
          <svg id="icon-open" class="block" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
            viewBox="0 0 20 20" fill="none">
            <path d="M3.33398 15H9.16732M3.33398 5H16.6673H3.33398ZM3.33398 10H16.6673H3.33398Z" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {% endif %}

          <!-- Close icon (same for both languages) -->
          <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none">
            <g clip-path="url(#clip0)">
              <path d="M15.625 4.375L4.375 15.625" stroke="#27272A" stroke-width="1.5" stroke-linecap="round"
